{
  "extraKnownMarketplaces": {
    "devantler-plugins": {
      "source": {
        "source": "github",
        "repo": "devantler-tech/agent-plugins"
      }
    }
  },
  "enabledPlugins": {
    "agentic-engineering@devantler-plugins": true,
    "ksail@devantler-plugins": true
  },
  "env": {
    "GH_TELEMETRY": "0",
    "GIT_NO_LAZY_FETCH": "1"
  },
  "permissions": {
    "ask": [
      "mcp__plugin_ksail_ksail__cluster_write",
      "mcp__plugin_ksail_ksail__project_write",
      "mcp__plugin_ksail_ksail__tenant_write",
      "mcp__plugin_ksail_ksail__workload_write"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/surveyor-hook-dispatch.sh"
          }
        ]
      }
    ]
  }
}
