{
  "extraKnownMarketplaces": {
    "devantler-plugins": {
      "source": {
        "source": "github",
        "repo": "devantler-tech/agent-plugins"
      }
    }
  },
  "enabledPlugins": {
    "agentic-engineering@devantler-plugins": true
  },
  "env": {
    "GH_TELEMETRY": "0"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/surveyor-hook-dispatch.sh"
          }
        ]
      }
    ]
  }
}
