---
import BusinessSite from './BusinessSite.astro';
import BusinessSupporting from './BusinessSupporting.astro';

const locale = Astro.url.pathname.startsWith('/da/') ? 'da' : 'en';
const section = Astro.url.pathname.split('/').filter(Boolean).at(-1);
---
{section === 'about' || section === 'projects' ? <BusinessSupporting locale={locale} section={section} /> : <BusinessSite locale={locale} />}
